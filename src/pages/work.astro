---
import Layout from "../layouts/Layout.astro";
import { DemoFrame } from "../components/DemoFrame";
import { projects } from "../data/projects";
---

<Layout
  title="Work — Nico Zessoules"
  description="Ten shipped projects: self-hosted remote access, deploy tooling, AI sprite generation, a stereo synthesizer, Godot developer tools, a terminal arcade and more."
  accent="var(--color-rose)"
>
  <section class="relative overflow-hidden border-b-[3px] border-ink">
    <div class="halftone pointer-events-none absolute inset-0"></div>

    <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h1 class="text-6xl sm:text-7xl display-tight">
        Doing the <span class="text-rose">work</span>
      </h1>

      <p class="mt-8 max-w-2xl text-xl font-semibold">
        Everything here is live, and most of it is open source.
      </p>
    </div>
  </section>

  {
    /* Same row rhythm as the about chapters: alternating background,
       alternating side, the demo standing in for the photograph. */
    projects.map((project, i) => (
      <section
        class:list={[
          "border-b-[3px] border-ink",
          i % 2 === 0 ? "bg-cream" : "",
        ]}
      >
        {/*
          Three grid children so the stack can be ordered: name, demo, then
          words. On lg the demo spans both rows down one side and the name
          sits directly above the text on the other.
        */}
        <div
          class:list={[
            "mx-auto grid max-w-6xl gap-6 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[540px_1fr] lg:gap-x-16 lg:gap-y-4",
            i % 2 !== 0 && "lg:grid-cols-[1fr_540px]",
          ]}
        >
          <h2
            class:list={[
              "text-5xl lg:row-start-1 lg:self-end",
              i % 2 === 0 ? "lg:col-start-2" : "lg:col-start-1",
            ]}
          >
            {project.name}
          </h2>

          <div
            class:list={[
              "w-full lg:row-span-2 lg:row-start-1 lg:self-center",
              i % 2 === 0 ? "lg:col-start-1" : "lg:col-start-2",
            ]}
          >
            <DemoFrame url={project.url} name={project.name} client:visible />
          </div>

          <div
            class:list={[
              "max-w-xl lg:row-start-2 lg:self-start",
              i % 2 === 0 ? "lg:col-start-2" : "lg:col-start-1",
            ]}
          >
            <p class="text-xl font-semibold">{project.blurb}</p>

            <div class="mt-6 flex flex-wrap gap-6">
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block border-b-[3px] border-ink text-lg font-extrabold hover:border-rose hover:text-rose"
              >
                Visit ↗
              </a>

              {project.repo && (
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block border-b-[3px] border-ink text-lg font-extrabold hover:border-rose hover:text-rose"
                >
                  Source ↗
                </a>
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }
</Layout>
