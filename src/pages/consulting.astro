---
import Layout from "../layouts/Layout.astro";

/* Ordered by what a visitor is most likely to have come here wanting. */
const services = [
  {
    title: "Websites for businesses",
    lead: "Fast, accessible, and yours.",
    body: "A marketing site or a storefront that loads instantly, reads well to search engines and screen readers alike, and lives in a repo you own — not inside a page builder charging rent on your own content.",
  },
  {
    title: "AI integrations",
    lead: "A model where it actually earns its keep.",
    body: "Assistants over your own documents, support triage, drafting and summarising inside the tools your team already uses. Scoped to a task worth automating, with evaluations, guardrails and a token bill that stays predictable.",
  },
  {
    title: "Product engineering",
    lead: "An empty repo to a thing your customers use.",
    body: "The whole build: schema, API, interface, auth, payments, and the deploy that puts it live. I have shipped ten of these on my own, so I know which corners are safe to cut and which ones bill you back later.",
  },
  {
    title: "Technical advisory",
    lead: "A senior engineer, part-time.",
    body: "Architecture review before you commit to it, code review while you build, and a straight answer on build-versus-buy. Fractional lead work for teams that need the judgement more often than they need the hands.",
  },
  {
    title: "Developer tooling & CI/CD",
    lead: "Merge, and it's live.",
    body: "Pipelines that build, test and deploy without a human in the loop, on your own servers if you would rather not rent someone else's. Plus the unglamorous half: secrets hygiene, reproducible builds, and logs that say what broke.",
  },
  {
    title: "Game development",
    lead: "Godot, and the tools around it.",
    body: "Editor addons, linting, asset pipelines and the engineering under a prototype that needs to become playable. This is what Avior Studio does when the game is mine; it works the same when the game is yours.",
  },
];

/* No numbers here on purpose — shape first, price once the scope is real. */
const engagements = [
  {
    title: "Project",
    body: "A defined thing with a definition of done. Fixed scope, an agreed schedule, and a demo you can click at the end of every week.",
  },
  {
    title: "Retainer",
    body: "A recurring share of my week, held for you. Best when the work is ongoing and the next priority is not knowable a month out.",
  },
  {
    title: "One-off",
    body: "An audit, an architecture session, a second opinion before a decision that is expensive to reverse. Days, not months.",
  },
];
---

<Layout
  title="Consulting — Nico Zessoules"
  description="Consulting from Nico Zessoules: product engineering, business websites, AI integrations, CI/CD and developer tooling, technical advisory and Godot game development."
  accent="var(--color-rose)"
>
  <section class="relative overflow-hidden border-b-[3px] border-ink">
    <div class="halftone pointer-events-none absolute inset-0"></div>

    <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <!-- The same two columns as the portfolio and about heroes, so all
           three interior pages open on the same shape. -->
      <div class="grid items-start gap-10 lg:grid-cols-[1.2fr_1fr]">
        <div>
          <h1 class="text-6xl sm:text-7xl display-tight">
            Let's build <span class="text-rose">yours</span>
          </h1>

          <p class="mt-8 max-w-2xl text-xl font-semibold">
            Ten years an engineer, and ten things I built because I wanted them
            to exist. Available now to do that for you instead.
          </p>

          <a
            href="mailto:nicozessoules@gmail.com?subject=Consulting"
            class="mt-8 inline-block border-[3px] border-ink bg-rose px-6 py-3 text-lg font-extrabold text-paper shadow-button transition-transform hover:-translate-y-1 active:translate-x-[4px] active:translate-y-[4px] active:shadow-none"
          >
            Start a conversation
          </a>
        </div>

        <blockquote class="border-[3px] border-ink bg-paper p-6 shadow-sticker">
          <p class="text-2xl font-extrabold leading-tight [font-stretch:112%]">
            "Perfection is achieved not when there is nothing more to add, but
            when there is nothing left to take away"
          </p>

          <footer class="mt-4 font-bold text-ink-soft">
            — Antoine de Saint-Exupéry, <cite>Terre des Hommes</cite>
          </footer>

          <p class="mt-4 text-ink-soft">
            How I scope. The cheapest software to run, maintain and hand over is
            the software that was never written, so we start by finding out how
            little of it you need.
          </p>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="border-b-[3px] border-ink bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 class="text-5xl">What I do</h2>

      <p class="mt-4 max-w-2xl text-xl font-semibold">
        Six lanes, and most engagements run down more than one of them.
      </p>

      <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <article class="flex flex-col border-[3px] border-ink bg-paper p-6 shadow-sticker">
              <h3 class="text-3xl">{service.title}</h3>

              <p class="mt-3 text-lg font-extrabold text-ink-soft">
                {service.lead}
              </p>

              <p class="mt-4 font-semibold">{service.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b-[3px] border-ink">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 class="text-5xl">How it works</h2>

      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {
          engagements.map((engagement) => (
            <div class="border-[3px] border-ink bg-paper p-6 shadow-sticker">
              <h3 class="text-3xl">{engagement.title}</h3>

              <p class="mt-4 font-semibold">{engagement.body}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-10 max-w-3xl text-xl font-semibold">
        Rates depend on the shape and the length, so there is no price list
        here. Tell me what you are building and I will tell you what it takes —
        including when the honest answer is that you do not need me.
      </p>
    </div>
  </section>

  <section class="border-b-[3px] border-ink bg-cream">
    <div
      class="mx-auto flex max-w-3xl flex-col items-center px-4 py-20 text-center sm:px-6"
    >
      <h2 class="text-5xl sm:text-6xl display-tight">
        Got something<br />worth building?
      </h2>

      <p class="mt-6 text-xl font-semibold">
        Send a couple of paragraphs about it. I read every one, and I answer
        even when it is not a fit.
      </p>

      <a
        href="mailto:nicozessoules@gmail.com?subject=Consulting"
        class="mt-8 inline-block border-[3px] border-ink bg-rose px-6 py-3 text-lg font-extrabold text-paper shadow-button transition-transform hover:-translate-y-1 active:translate-x-[4px] active:translate-y-[4px] active:shadow-none"
      >
        nicozessoules@gmail.com
      </a>

      <a
        href="/portfolio"
        class="mt-6 inline-block border-b-[3px] border-ink text-lg font-extrabold hover:border-rose hover:text-rose"
      >
        See the work first →
      </a>
    </div>
  </section>
</Layout>
