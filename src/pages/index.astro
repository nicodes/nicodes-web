---
import { Image } from "astro:assets";

import Layout from "../layouts/Layout.astro";

import nicoImg from "../assets/nico.png";
---

<Layout
  title="Nico Zessoules — engineer, tool-maker, game builder"
  description="Nico Zessoules is a senior software engineer at GitHub and an independent developer in Boulder, Colorado, building web apps, developer tools and games."
  accent="var(--color-rose)"
>
  <!--
    The whole page. The header measures ~4.5rem with its accent rule, so the
    hero fills the first screen exactly and the footer starts below it.
  -->
  <section
    class="relative flex min-h-[calc(100svh-4.5rem)] items-center overflow-hidden border-b-[3px] border-ink"
  >
    <div class="halftone pointer-events-none absolute inset-0"></div>

    <div
      class="relative mx-auto flex w-full max-w-3xl flex-col items-center gap-8 px-4 py-12 text-center sm:gap-10 sm:px-6 sm:py-16"
    >
      <!-- Fluid so the one line can never clip: at 320px it still fits. -->
      <h1
        class="animate-rise whitespace-nowrap text-[clamp(2.5rem,13vw,4.5rem)] display-tight"
      >
        Hi, I'm <span class="text-rose">Nico</span>.
      </h1>

      <div class="relative animate-rise [animation-delay:120ms]">
        <!-- Flat layered shapes, the way the portrait itself is built. -->
        <div
          class="absolute -right-4 -top-4 h-full w-full border-[3px] border-ink bg-rose"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute -bottom-4 -left-4 h-full w-full border-[3px] border-ink bg-gold"
          aria-hidden="true"
        >
        </div>

        <Image
          src={nicoImg}
          alt="Illustrated portrait of Nico in a cap and heart-shaped glasses"
          width={360}
          height={360}
          class="relative block h-[240px] w-[240px] border-[3px] border-ink object-cover sm:h-[320px] sm:w-[320px]"
          loading="eager"
        />

        <p
          class="absolute -bottom-5 left-6 -rotate-3 border-[3px] border-ink bg-paper px-3 py-1 text-sm font-extrabold uppercase tracking-wider shadow-sticker-sm"
        >
          ni.codes
        </p>
      </div>

      <p
        class="max-w-xl animate-rise text-xl font-semibold [animation-delay:240ms] sm:text-2xl"
      >
        I build for the browser, the terminal, and the odd video game in
        between.
      </p>

      <div
        class="flex animate-rise flex-wrap justify-center gap-4 [animation-delay:360ms]"
      >
        <a
          href="/work"
          class="border-[3px] border-ink bg-rose px-6 py-3 text-lg font-extrabold text-paper shadow-sticker transition-transform hover:-translate-y-1 active:translate-x-[4px] active:translate-y-[4px] active:shadow-none"
        >
          See the work
        </a>

        <a
          href="/about"
          class="border-[3px] border-ink bg-gold px-6 py-3 text-lg font-extrabold shadow-sticker transition-transform hover:-translate-y-1 active:translate-x-[4px] active:translate-y-[4px] active:shadow-none"
        >
          Who I am
        </a>
      </div>
    </div>
  </section>
</Layout>
