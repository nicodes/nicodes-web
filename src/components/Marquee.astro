---
interface Props {
  items: string[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;

// The track is rendered twice so the -50% keyframe lands seamlessly.
const track = [...items, ...items];
---

<div
  class:list={[
    "overflow-hidden border-y-[3px] border-ink bg-ink py-3 text-paper",
    className,
  ]}
  aria-hidden="true"
>
  <div class="flex w-max animate-marquee items-center gap-6 pr-6">
    {
      track.map((item) => (
        <>
          <span class="text-xl font-extrabold uppercase tracking-wide [font-stretch:112%] whitespace-nowrap">
            {item}
          </span>
          <span class="text-gold" aria-hidden="true">
            ✦
          </span>
        </>
      ))
    }
  </div>
</div>
