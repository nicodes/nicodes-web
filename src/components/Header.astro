---
import { ContactMenu } from "./ContactMenu";
import { MobileMenu } from "./MobileMenu";
import { contact, pages } from "../data/nav";

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b-[3px] border-ink bg-paper">
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
  >
    <a
      href="/"
      class="text-2xl font-extrabold [font-stretch:118%] tracking-tight transition-colors hover:text-coral"
      aria-label="Nicodes, home"
    >
      n<span class="text-coral">i</span>codes
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        pages.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? "page" : undefined}
            class:list={[
              "px-3 py-1.5 text-lg font-bold transition-colors hover:text-coral",
              isCurrent(link.href) &&
                "text-coral underline decoration-2 underline-offset-8",
            ]}
          >
            {link.label}
          </a>
        ))
      }

      <div class="ml-2">
        <ContactMenu links={contact} client:load />
      </div>
    </nav>

    <MobileMenu pages={pages} contact={contact} client:load />
  </div>
</header>
