---
const year = new Date().getFullYear();

const elsewhere = [
  { href: "https://github.com/nicodes", label: "GitHub" },
  { href: "https://www.linkedin.com/in/nicozessoules", label: "LinkedIn" },
  { href: "https://www.instagram.com/stonebloom", label: "Instagram" },
  { href: "https://www.avior.studio", label: "Avior Studio" },
];
---

<footer class="border-t-[3px] border-ink bg-ink text-paper">
  <div class="stripes h-3 w-full opacity-30"></div>

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-md">
        <h2 class="text-4xl sm:text-5xl display-tight">
          Got something<br />worth building?
        </h2>

        <a
          href="mailto:nicozessoules@gmail.com"
          class="mt-6 inline-block border-[3px] border-mint bg-gold px-5 py-2.5 text-lg font-bold text-ink shadow-[4px_4px_0_var(--color-mint)] transition-transform hover:-translate-y-0.5 active:translate-x-[4px] active:translate-y-[4px] active:shadow-none"
        >
          nicozessoules@gmail.com
        </a>
      </div>

      <nav aria-label="Elsewhere">
        <h3 class="text-sm font-bold uppercase tracking-[0.2em] text-mint">
          Elsewhere
        </h3>

        <ul class="mt-4 space-y-2">
          {
            elsewhere.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-lg font-semibold underline decoration-mint decoration-2 underline-offset-4 hover:text-gold hover:decoration-gold"
                >
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="mt-12 border-t-2 border-paper/20 pt-6 text-sm text-mint">
      © {year} Nico Zessoules — built with Astro, Qwik and a great deal of
      coffee.
    </p>
  </div>
</footer>
